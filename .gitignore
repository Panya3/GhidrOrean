# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/

# Frozen binaries are release assets, never commits
*.exe
*.dll
*.pdb

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Editors / IDEs
.vscode/
.idea/
*.swp
*~

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Local logs / scratch dumps
*.log
